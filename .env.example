# ──────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your own keys.
# .env.local is gitignored (via *.local) — never commit secrets.
# ──────────────────────────────────────────────────────────────

# Supabase — Project URL and publishable (anon) key
# Find these in: Supabase Dashboard → Project Settings → API Keys
# Publishable key is safe to expose in the browser when RLS is enabled.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
